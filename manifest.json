{
  "manifest_version": 3,
  "name": "Stability Guard for ChatGPT",
  "version": "1.0.9",
  "description": "Reduces rendering churn in long ChatGPT chats. Built for the current ChatGPT web UI; site updates may require an extension update.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Stability Guard for ChatGPT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "prehide.js"
      ],
      "css": [
        "prehide.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "recent-window.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
